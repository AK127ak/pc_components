digraph ER {
    graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=1.0, fontname="Helvetica"];
    node [shape=plain, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10, color="#444444"];

    users [label=<
    <table border="1" cellborder="0" cellspacing="0" bgcolor="white">
      <tr><td bgcolor="#2dd4bf"><b>users</b></td></tr>
      <tr><td align="left">PK  id</td></tr>
      <tr><td align="left">    login</td></tr>
      <tr><td align="left">    password_hash</td></tr>
      <tr><td align="left">    full_name</td></tr>
      <tr><td align="left">    role</td></tr>
    </table>>];

    categories [label=<
    <table border="1" cellborder="0" cellspacing="0" bgcolor="white">
      <tr><td bgcolor="#2dd4bf"><b>categories</b></td></tr>
      <tr><td align="left">PK  id</td></tr>
      <tr><td align="left">    name</td></tr>
    </table>>];

    manufacturers [label=<
    <table border="1" cellborder="0" cellspacing="0" bgcolor="white">
      <tr><td bgcolor="#2dd4bf"><b>manufacturers</b></td></tr>
      <tr><td align="left">PK  id</td></tr>
      <tr><td align="left">    name</td></tr>
    </table>>];

    suppliers [label=<
    <table border="1" cellborder="0" cellspacing="0" bgcolor="white">
      <tr><td bgcolor="#2dd4bf"><b>suppliers</b></td></tr>
      <tr><td align="left">PK  id</td></tr>
      <tr><td align="left">    name</td></tr>
    </table>>];

    products [label=<
    <table border="1" cellborder="0" cellspacing="0" bgcolor="white">
      <tr><td bgcolor="#f5a623"><b>products</b></td></tr>
      <tr><td align="left">PK  id</td></tr>
      <tr><td align="left">    name</td></tr>
      <tr><td align="left">FK  category_id</td></tr>
      <tr><td align="left">    description</td></tr>
      <tr><td align="left">FK  manufacturer_id</td></tr>
      <tr><td align="left">FK  supplier_id</td></tr>
      <tr><td align="left">    price</td></tr>
      <tr><td align="left">    unit</td></tr>
      <tr><td align="left">    quantity</td></tr>
      <tr><td align="left">    discount</td></tr>
      <tr><td align="left">    image_path</td></tr>
    </table>>];

    orders [label=<
    <table border="1" cellborder="0" cellspacing="0" bgcolor="white">
      <tr><td bgcolor="#f5a623"><b>orders</b></td></tr>
      <tr><td align="left">PK  id</td></tr>
      <tr><td align="left">    article</td></tr>
      <tr><td align="left">FK  product_id</td></tr>
      <tr><td align="left">    quantity</td></tr>
      <tr><td align="left">    status</td></tr>
      <tr><td align="left">    pickup_address</td></tr>
      <tr><td align="left">    order_date</td></tr>
      <tr><td align="left">    issue_date</td></tr>
    </table>>];

    categories    -> products [label="1:M", dir=back, arrowtail=crow];
    manufacturers -> products [label="1:M", dir=back, arrowtail=crow];
    suppliers     -> products [label="1:M", dir=back, arrowtail=crow];
    products      -> orders   [label="1:M", dir=back, arrowtail=crow];
}
